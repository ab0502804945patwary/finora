# Public URLs (used in QR codes and cross-links)
NEXT_PUBLIC_SITE_URL=https://finoraca.com
NEXT_PUBLIC_VERIFY_URL=https://everify.finoraca.com

# Admin login (everify.finoraca.com/admin)
ADMIN_PASSWORD=change-me-to-a-long-random-password
# Any random string, 32+ characters
SESSION_SECRET=change-me-to-a-random-32-plus-character-string

# Database + file storage: Supabase. Leave empty locally to use ./data (SQLite + local PDFs).
# Run supabase/schema.sql once in the Supabase SQL Editor. The service role key is server-only: never commit it or prefix it with NEXT_PUBLIC_.

# Private Storage bucket for issued PDFs (create a private bucket named "documents")
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=
# Optional alternative for PDFs: Cloudflare R2, used only if Supabase is not set
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
