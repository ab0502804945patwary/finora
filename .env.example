# Public URLs (used in QR codes and cross-links)
NEXT_PUBLIC_SITE_URL=https://finoraca.com
NEXT_PUBLIC_VERIFY_URL=https://everify.finoraca.com

# Admin login (everify.finoraca.com/admin)
ADMIN_PASSWORD=change-me-to-a-long-random-password
# Any random string, 32+ characters
SESSION_SECRET=change-me-to-a-random-32-plus-character-string

# Database: Turso (libSQL). Leave empty locally to use ./data/local.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# File storage for issued PDFs. Leave all empty locally to use ./data/files.
# Option 1: Supabase Storage (private bucket). Service role key is server-only, never expose it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=
# Option 2: Cloudflare R2 (private bucket), used only if Supabase is not set
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
